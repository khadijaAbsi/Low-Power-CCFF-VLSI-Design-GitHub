Cccff_N;1{vhdl}||artwork|1769767834017|1769767834031||FACET_message()S["-- VHDL automatically generated by the Electric VLSI Design System, version ",-- 9.07,"",-------------------- Cell ccff_N:ccff_N{lay} --------------------,"entity ccff_N is port(D, Q, clk, en, gnd, vdd, xor_: inout BIT);",  end ccff_N;,"",architecture ccff_N_BODY of ccff_N is,"  component nMOStran port(poly_left, diff_top, diff_bottom: inout BIT);",    end component;,"  component PMOStran port(poly_left, diff_top, diff_bottom: inout BIT);",    end component;,  component ground port(metal_1_well: inout BIT);,    end component;,  component power port(metal_1_substrate: inout BIT);,    end component;,"","  signal net_1, net_100, net_105, net_151, net_245, net_246, net_3, net_9, net_91",    : BIT;,"",begin,"  nmos_0: nMOStran port map(net_105, gnd, Q);","  nmos_1: nMOStran port map(D, net_100, gnd);","  nmos_2: nMOStran port map(en, net_105, net_100);","  nmos_3: nMOStran port map(net_9, net_91, net_105);","  nmos_4: nMOStran port map(Q, gnd, net_91);","  nmos_5: nMOStran port map(en, gnd, net_9);","  nmos_6: nMOStran port map(net_151, Q, xor_);","  nmos_7: nMOStran port map(D, gnd, net_151);","  nmos_8: nMOStran port map(Q, net_151, xor_);","  nmos_9: nMOStran port map(clk, net_245, net_246);","  nmos_10: nMOStran port map(xor_, net_246, gnd);","  nmos_11: nMOStran port map(net_245, gnd, en);","  pmos_0: PMOStran port map(net_105, vdd, Q);","  pmos_1: PMOStran port map(D, net_1, vdd);","  pmos_2: PMOStran port map(net_9, net_105, net_1);","  pmos_3: PMOStran port map(en, net_3, net_105);","  pmos_4: PMOStran port map(Q, vdd, net_3);","  pmos_5: PMOStran port map(en, vdd, net_9);","  pmos_6: PMOStran port map(D, Q, xor_);","  pmos_7: PMOStran port map(D, vdd, net_151);","  pmos_8: PMOStran port map(Q, D, xor_);","  pmos_9: PMOStran port map(clk, vdd, net_245);","  pmos_10: PMOStran port map(xor_, net_245, vdd);","  pmos_11: PMOStran port map(net_245, vdd, en);",  substr_0: ground port map(gnd);,  well_0: power port map(vdd);,end ccff_N_BODY;]
